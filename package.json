{
  "name": "@simtabi/cli-kit-js-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for @simtabi/cli-kit-js \u2014 the JavaScript implementation of the cli-kit family",
  "license": "MIT",
  "author": "Simtabi",
  "homepage": "https://github.com/simtabi/cli-kit-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtabi/cli-kit-js.git"
  },
  "bugs": {
    "url": "https://github.com/simtabi/cli-kit-js/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "api:check": "turbo run api:check",
    "api:update": "turbo run api:update",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@microsoft/api-extractor": "^7.47.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
