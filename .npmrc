# Security & determinism
engine-strict=true
strict-peer-dependencies=true
auto-install-peers=false
save-exact=false
# No lockfile: this is a library monorepo, and a library's lock records a resolution
# consumers never use. `prefer-frozen-lockfile=true` sat here too, which asked pnpm to use
# a frozen lockfile it had just been told never to write.
package-lock=false

# Provenance for published packages
provenance=true

# Reject anything not satisfying registry signatures
verify-store-integrity=true
