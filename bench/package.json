{
  "name": "@simtabi/cli-kit-js-bench",
  "version": "0.0.0",
  "private": true,
  "description": "Performance benchmarks for cli-kit-js. Not published.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "bench": "node --experimental-strip-types ./run.ts",
    "bench:parser": "node --experimental-strip-types ./parser.ts",
    "bench:text": "node --experimental-strip-types ./text.ts",
    "bench:render": "node --experimental-strip-types ./render.ts",
    "bench:html": "node --experimental-strip-types ./html.ts",
    "bench:config": "node --experimental-strip-types ./config.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests in bench'",
    "build": "echo 'no build in bench'",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@simtabi/cli-kit-js": "workspace:*",
    "@simtabi/cli-kit-js-ansi": "workspace:*",
    "@simtabi/cli-kit-js-config": "workspace:*",
    "@simtabi/cli-kit-js-parser": "workspace:*",
    "@simtabi/cli-kit-js-render": "workspace:*",
    "@simtabi/cli-kit-js-text": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tinybench": "^3.0.0",
    "typescript": "catalog:"
  }
}
