{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",

  // Per-package configs extend this. Each must set `mainEntryPointFilePath`
  // explicitly; the api-extractor `<projectFolder>` token doesn't resolve
  // correctly through `extends`, so we don't use it here.

  "bundledPackages": [],

  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM"],
        "moduleResolution": "Bundler",
        "module": "ESNext",
        "target": "ES2022"
      },
      "include": ["./dist/**/*.d.ts"]
    }
  },

  "apiReport": {
    "enabled": true,
    "reportFolder": "./etc/",
    "reportTempFolder": "./temp/",
    "reportFileName": "<unscopedPackageName>.api.md"
  },

  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },

  "messages": {
    "compilerMessageReporting": {
      "default": { "logLevel": "warning" }
    },
    "extractorMessageReporting": {
      "default": { "logLevel": "warning" },
      "ae-missing-release-tag": { "logLevel": "none" },
      "ae-internal-missing-underscore": { "logLevel": "none" },
      "ae-forgotten-export": { "logLevel": "none" }
    },
    "tsdocMessageReporting": {
      "default": { "logLevel": "none" }
    }
  }
}
