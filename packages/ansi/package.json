{
  "name": "@simtabi/cli-kit-js-ansi",
  "version": "0.0.0",
  "description": "SGR colors, strip, and capability detection. Zero deps. Honors NO_COLOR, FORCE_COLOR, isTTY, COLORTERM.",
  "license": "MIT",
  "author": "Simtabi",
  "homepage": "https://github.com/simtabi/cli-kit-js/tree/main/packages/ansi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtabi/cli-kit-js.git",
    "directory": "packages/ansi"
  },
  "bugs": {
    "url": "https://github.com/simtabi/cli-kit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "etc"],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "keywords": ["cli", "cli-kit", "ansi", "color", "sgr", "chalk", "kleur", "typescript"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage",
    "api:check": "api-extractor run --verbose",
    "api:update": "api-extractor run --local --verbose"
  },
  "size-limit": [
    {
      "name": "createColors() + sanitize() ESM",
      "path": "dist/index.js",
      "limit": "2 KB",
      "gzip": true
    }
  ],
  "dependencies": {},
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "size-limit": "catalog:",
    "tsup": "catalog:",
    "@typescript/typescript6": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
