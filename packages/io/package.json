{
  "name": "@simtabi/cli-kit-js-io",
  "version": "0.0.0",
  "description": "IOAdapter interface + Node, DOM, DevTools console, and Memory implementations. Single abstraction over stdin/stdout/stderr across runtimes.",
  "license": "MIT",
  "author": "Simtabi",
  "homepage": "https://github.com/simtabi/cli-kit-js/tree/main/packages/io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtabi/cli-kit-js.git",
    "directory": "packages/io"
  },
  "bugs": {
    "url": "https://github.com/simtabi/cli-kit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "import": "./dist/console.js",
      "require": "./dist/console.cjs"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "require": "./dist/memory.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "etc"],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "keywords": ["cli", "cli-kit", "io", "stdin", "stdout", "tty", "dom", "typescript"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage",
    "api:check": "api-extractor run --verbose",
    "api:update": "api-extractor run --local --verbose"
  },
  "size-limit": [
    {
      "name": "IOAdapter + Node adapter ESM",
      "path": "dist/index.js",
      "limit": "5 KB",
      "gzip": true,
      "ignore": ["node:readline", "node:stream", "readline", "stream"]
    },
    {
      "name": "DOM adapter ESM",
      "path": "dist/dom.js",
      "limit": "5 KB",
      "gzip": true
    },
    {
      "name": "Console adapter ESM",
      "path": "dist/console.js",
      "limit": "3 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@simtabi/cli-kit-js-ansi": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "size-limit": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
