{
  "name": "@simtabi/cli-kit-js-core",
  "version": "0.1.0",
  "description": "Command definition, runner, lifecycle, AbortSignal wiring, hook bus, logger. The async-correct heart of cli-kit-js.",
  "license": "MIT",
  "author": "Simtabi",
  "homepage": "https://github.com/simtabi/cli-kit-js/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtabi/cli-kit-js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/simtabi/cli-kit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "etc"],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "keywords": ["cli", "cli-kit", "command", "runner", "abort-signal", "typescript"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage",
    "api:check": "api-extractor run --verbose",
    "api:update": "api-extractor run --local --verbose"
  },
  "size-limit": [
    {
      "name": "run() + defineCommand + cli builder ESM",
      "path": "dist/index.js",
      "limit": "12 KB",
      "gzip": true,
      "ignore": [
        "node:readline",
        "node:stream",
        "node:fs",
        "node:fs/promises",
        "node:path",
        "readline",
        "stream",
        "fs",
        "fs/promises",
        "path"
      ]
    }
  ],
  "dependencies": {
    "@simtabi/cli-kit-js-ansi": "workspace:*",
    "@simtabi/cli-kit-js-config": "workspace:*",
    "@simtabi/cli-kit-js-io": "workspace:*",
    "@simtabi/cli-kit-js-parser": "workspace:*",
    "@simtabi/cli-kit-js-text": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "size-limit": "catalog:",
    "tsup": "catalog:",
    "@typescript/typescript6": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
