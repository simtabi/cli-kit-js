{
  "name": "@simtabi/cli-kit-js-prompts",
  "version": "0.0.0",
  "description": "Interactive prompts: text, password, confirm, select, multiselect. Raw-mode TTY + non-TTY readLine fallback.",
  "license": "MIT",
  "author": "Simtabi",
  "homepage": "https://github.com/simtabi/cli-kit-js/tree/main/packages/prompts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtabi/cli-kit-js.git",
    "directory": "packages/prompts"
  },
  "bugs": {
    "url": "https://github.com/simtabi/cli-kit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22.0.0" },
  "sideEffects": false,
  "keywords": ["cli", "cli-kit", "prompt", "interactive", "input", "select", "password", "typescript"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "size-limit": [
    {
      "name": "prompts ESM",
      "path": "dist/index.js",
      "limit": "6 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@simtabi/cli-kit-js-ansi": "workspace:*",
    "@simtabi/cli-kit-js-io": "workspace:*",
    "@simtabi/cli-kit-js-text": "workspace:*"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "catalog:",
    "@simtabi/cli-kit-js-testing": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "size-limit": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
